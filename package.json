{
  "name": "spec-layer",
  "version": "1.0.0",
  "private": true,
  "description": "Local-first Figma-to-Markdown design system specification toolkit",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SamsonHD/spec-layer.git"
  },
  "bugs": {
    "url": "https://github.com/SamsonHD/spec-layer/issues"
  },
  "homepage": "https://github.com/SamsonHD/spec-layer#readme",
  "engines": {
    "node": ">=20.9.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -p packages/extractor/tsconfig.json --noEmit && tsc -p packages/plugin/tsconfig.json --noEmit && tsc -p packages/proxy/tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings=0",
    "build:plugin": "node packages/plugin/build.mjs",
    "build:plugin:vnext": "node packages/plugin/build.mjs",
    "audit:production": "npm audit --omit=dev",
    "audit:active": "npm audit --omit=dev --workspace @spec-layer/extractor --workspace @spec-layer/plugin --workspace @spec-layer/proxy",
    "check": "npm run lint && npm run typecheck && npm test && npm run build:plugin:legacy && npm run build:plugin:vnext",
    "check:ci": "npm run lint && npm run typecheck && npm run test:coverage && npm run build:plugin:legacy && npm run build:plugin:vnext && npm run audit:production",
    "build:plugin:legacy": "UI_LEGACY=1 node packages/plugin/build.mjs"
  },
  "overrides": {
    "brace-expansion": "^5.0.8",
    "minimatch": "^10.2.6",
    "postcss": "^8.5.24",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^4.1.8",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.12",
    "js-yaml": "^5.3.0",
    "next": "^16.2.12",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "typescript": "^5.6.0",
    "vitest": "^4.1.8"
  },
  "optionalDependencies": {
    "@rolldown/binding-linux-x64-gnu": "1.0.3"
  }
}
