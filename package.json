{
  "name": "spec-layer",
  "version": "1.0.0",
  "private": true,
  "description": "Figma plugin that turns components and variables into design-system documentation",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SamsonHD/spec-layer.git"
  },
  "bugs": {
    "url": "https://github.com/SamsonHD/spec-layer/issues"
  },
  "homepage": "https://github.com/SamsonHD/spec-layer#readme",
  "engines": {
    "node": ">=20.9.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -p packages/extractor/tsconfig.json --noEmit && tsc -p packages/plugin/tsconfig.json --noEmit && tsc -p packages/proxy/tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings=0",
    "build:plugin": "node packages/plugin/build.mjs",
    "audit:production": "npm audit --omit=dev",
    "audit:active": "npm audit --omit=dev --workspace @spec-layer/extractor --workspace @spec-layer/plugin --workspace @spec-layer/proxy",
    "check:nul": "node scripts/check-nul-bytes.mjs",
    "check": "npm run lint && npm run typecheck && npm run check:nul && npm test && npm run build:plugin && npm run check:sandbox",
    "check:ci": "npm run lint && npm run typecheck && npm run check:nul && npm run test:coverage && npm run build:plugin && npm run check:sandbox && npm run audit:production",
    "check:sandbox": "node scripts/check-main-sandbox.mjs"
  },
  "overrides": {
    "brace-expansion": "^5.0.8",
    "minimatch": "^10.2.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^4.1.8",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^9.39.4",
    "globals": "^14.0.0",
    "happy-dom": "^20.11.2",
    "js-yaml": "^5.3.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.61.0",
    "vitest": "^4.1.8"
  }
}
