{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec-layer.com/schemas/foundation-context/v5.json",
  "title": "Foundation Context v5",
  "description": "Published Level 1 schema for the Foundation Context v5 export contract (spec §5.1, §6, §7, §8, §9, §18 Level 1). This schema is the consumer-facing twin of the hand-written validator at packages/extractor/src/v5/validate.ts, which runs the same checks inside the Figma plugin sandbox where ajv cannot load. Collections, modes, tokens, styles, lifecycle records and bindings are validated deeply enough that any artifact accepted here is safe to pass to Level 2 referential validation. test/v5/schemaParity.test.ts proves the two agree on every shared fixture.",
  "type": "object",
  "required": [
    "spec_layer",
    "completeness",
    "collections",
    "tokens",
    "styles",
    "diagnostics",
    "statistics"
  ],
  "properties": {
    "spec_layer": { "type": "object" },
    "completeness": { "$ref": "#/$defs/completeness" },
    "collections": {
      "type": "array",
      "items": { "$ref": "#/$defs/collection" }
    },
    "tokens": {
      "type": "array",
      "items": { "$ref": "#/$defs/token" }
    },
    "styles": {
      "type": "object",
      "required": ["typography", "effects"],
      "properties": {
        "typography": {
          "type": "array",
          "items": { "$ref": "#/$defs/typography_style" }
        },
        "effects": {
          "type": "array",
          "items": { "$ref": "#/$defs/effect_style" }
        }
      }
    },
    "diagnostics": { "type": "array" },
    "statistics": { "type": "object" },
    "guidelines": { "$ref": "#/$defs/guidelines" }
  },
  "$defs": {
    "guidelines": {
      "type": "object",
      "required": ["origin", "group_descriptions"],
      "additionalProperties": false,
      "properties": {
        "origin": { "const": "generated" },
        "group_descriptions": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": { "type": "string" }
          }
        }
      }
    },
    "entity_identity": {
      "type": "object",
      "required": ["id", "name", "path"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "path": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "suggested_code_name": { "type": "string" }
      }
    },
    "publication": {
      "type": "object",
      "required": ["published", "hidden_from_publishing"],
      "properties": {
        "published": { "type": "boolean" },
        "hidden_from_publishing": { "type": "boolean" }
      }
    },
    "source_state": {
      "type": "object",
      "required": ["remote", "library_file_id", "library_name", "modified_at"],
      "properties": {
        "remote": { "type": "boolean" },
        "library_file_id": { "type": ["string", "null"] },
        "library_name": { "type": ["string", "null"] },
        "modified_at": { "type": ["string", "null"] }
      }
    },
    "lifecycle": {
      "type": "object",
      "required": ["status", "replacement_id"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["active", "deprecated", "archived"]
        },
        "replacement_id": { "type": ["string", "null"] }
      }
    },
    "mode": {
      "type": "object",
      "required": ["id", "name", "order"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "order": { "type": "number" }
      }
    },
    "collection": {
      "allOf": [
        { "$ref": "#/$defs/entity_identity" },
        {
          "type": "object",
          "required": ["default_mode_id", "modes"],
          "properties": {
            "default_mode_id": { "type": "string", "minLength": 1 },
            "modes": {
              "type": "array",
              "items": { "$ref": "#/$defs/mode" }
            },
            "publication": { "$ref": "#/$defs/publication" },
            "source": { "$ref": "#/$defs/source_state" }
          }
        }
      ]
    },
    "completeness": {
      "type": "object",
      "required": ["collections", "styles", "unavailable_sources"],
      "properties": {
        "collections": { "$ref": "#/$defs/completeness_value" },
        "styles": { "$ref": "#/$defs/completeness_value" },
        "unavailable_sources": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "completeness_value": {
      "type": "string",
      "enum": ["complete", "partial", "unavailable"]
    },

    "token": {
      "allOf": [
        { "$ref": "#/$defs/entity_identity" },
        {
          "type": "object",
          "required": ["collection_id", "type", "description", "scopes", "values"],
          "properties": {
            "collection_id": { "type": "string", "minLength": 1 },
            "type": { "$ref": "#/$defs/token_type" },
            "description": { "type": "string" },
            "scopes": {
              "type": "array",
              "items": { "type": "string" }
            },
            "publication": { "$ref": "#/$defs/publication" },
            "lifecycle": { "$ref": "#/$defs/lifecycle" },
            "values": {
              "type": "object",
              "additionalProperties": { "$ref": "#/$defs/canonical_value" }
            }
          }
        },
        {
          "oneOf": [
            {
              "type": "object",
              "required": ["type", "values"],
              "properties": {
                "type": { "const": "color" },
                "values": {
                  "type": "object",
                  "additionalProperties": { "$ref": "#/$defs/value_type_color" }
                }
              }
            },
            {
              "type": "object",
              "required": ["type", "values"],
              "properties": {
                "type": { "const": "dimension" },
                "values": {
                  "type": "object",
                  "additionalProperties": { "$ref": "#/$defs/value_type_dimension" }
                }
              }
            },
            {
              "type": "object",
              "required": ["type", "values"],
              "properties": {
                "type": { "const": "number" },
                "values": {
                  "type": "object",
                  "additionalProperties": { "$ref": "#/$defs/value_type_number" }
                }
              }
            },
            {
              "type": "object",
              "required": ["type", "values"],
              "properties": {
                "type": { "const": "string" },
                "values": {
                  "type": "object",
                  "additionalProperties": { "$ref": "#/$defs/value_type_string" }
                }
              }
            },
            {
              "type": "object",
              "required": ["type", "values"],
              "properties": {
                "type": { "const": "boolean" },
                "values": {
                  "type": "object",
                  "additionalProperties": { "$ref": "#/$defs/value_type_boolean" }
                }
              }
            },
            {
              "type": "object",
              "required": ["type", "values"],
              "properties": {
                "type": { "const": "duration" },
                "values": {
                  "type": "object",
                  "additionalProperties": { "$ref": "#/$defs/value_type_duration" }
                }
              }
            },
            {
              "type": "object",
              "required": ["type", "values"],
              "properties": {
                "type": { "const": "cubic_bezier" },
                "values": {
                  "type": "object",
                  "additionalProperties": { "$ref": "#/$defs/value_type_cubic_bezier" }
                }
              }
            },
            {
              "type": "object",
              "required": ["type", "values"],
              "properties": {
                "type": { "const": "font_family" },
                "values": {
                  "type": "object",
                  "additionalProperties": { "$ref": "#/$defs/value_type_font_family" }
                }
              }
            }
          ]
        }
      ]
    },

    "token_type": {
      "type": "string",
      "enum": [
        "color", "dimension", "number", "string", "boolean",
        "duration", "cubic_bezier", "font_family"
      ]
    },
    "unit": {
      "type": "string",
      "enum": ["px", "rem", "em", "%", "deg", "ms", "s"]
    },

    "canonical_value": {
      "oneOf": [
        { "$ref": "#/$defs/literal_value" },
        { "$ref": "#/$defs/alias_value" },
        { "$ref": "#/$defs/missing_value" }
      ]
    },
    "value_type_color": {
      "type": "object",
      "properties": {
        "value": { "$ref": "#/$defs/color_value" },
        "resolved": {
          "type": "object",
          "properties": {
            "value": {
              "oneOf": [
                { "$ref": "#/$defs/color_value" },
                { "type": "null" }
              ]
            }
          }
        }
      }
    },
    "value_type_dimension": {
      "type": "object",
      "properties": {
        "value": { "$ref": "#/$defs/dimension_value" },
        "resolved": {
          "type": "object",
          "properties": {
            "value": {
              "oneOf": [
                { "$ref": "#/$defs/dimension_value" },
                { "type": "null" }
              ]
            }
          }
        }
      }
    },
    "value_type_number": {
      "type": "object",
      "properties": {
        "value": { "$ref": "#/$defs/number_value" },
        "resolved": {
          "type": "object",
          "properties": {
            "value": {
              "oneOf": [
                { "$ref": "#/$defs/number_value" },
                { "type": "null" }
              ]
            }
          }
        }
      }
    },
    "value_type_string": {
      "type": "object",
      "properties": {
        "value": { "$ref": "#/$defs/string_value" },
        "resolved": {
          "type": "object",
          "properties": {
            "value": {
              "oneOf": [
                { "$ref": "#/$defs/string_value" },
                { "type": "null" }
              ]
            }
          }
        }
      }
    },
    "value_type_boolean": {
      "type": "object",
      "properties": {
        "value": { "$ref": "#/$defs/boolean_value" },
        "resolved": {
          "type": "object",
          "properties": {
            "value": {
              "oneOf": [
                { "$ref": "#/$defs/boolean_value" },
                { "type": "null" }
              ]
            }
          }
        }
      }
    },
    "value_type_duration": {
      "type": "object",
      "properties": {
        "value": { "$ref": "#/$defs/duration_value" },
        "resolved": {
          "type": "object",
          "properties": {
            "value": {
              "oneOf": [
                { "$ref": "#/$defs/duration_value" },
                { "type": "null" }
              ]
            }
          }
        }
      }
    },
    "value_type_cubic_bezier": {
      "type": "object",
      "properties": {
        "value": { "$ref": "#/$defs/cubic_bezier_value" },
        "resolved": {
          "type": "object",
          "properties": {
            "value": {
              "oneOf": [
                { "$ref": "#/$defs/cubic_bezier_value" },
                { "type": "null" }
              ]
            }
          }
        }
      }
    },
    "value_type_font_family": {
      "type": "object",
      "properties": {
        "value": { "$ref": "#/$defs/font_family_value" },
        "resolved": {
          "type": "object",
          "properties": {
            "value": {
              "oneOf": [
                { "$ref": "#/$defs/font_family_value" },
                { "type": "null" }
              ]
            }
          }
        }
      }
    },
    "literal_value": {
      "type": "object",
      "required": ["kind", "value"],
      "properties": {
        "kind": { "const": "literal" },
        "value": { "$ref": "#/$defs/typed_value" }
      }
    },
    "alias_value": {
      "type": "object",
      "required": ["kind", "reference", "resolved"],
      "properties": {
        "kind": { "const": "alias" },
        "reference": { "$ref": "#/$defs/alias_reference" },
        "resolved": { "$ref": "#/$defs/alias_resolution" }
      }
    },
    "missing_value": {
      "type": "object",
      "required": ["kind", "reason"],
      "properties": {
        "kind": { "const": "missing" },
        "reason": { "type": "string", "minLength": 1 }
      }
    },

    "alias_reference": {
      "type": "object",
      "required": ["target_id", "target_collection_id", "target_path", "external"],
      "properties": {
        "target_id": { "type": ["string", "null"] },
        "target_collection_id": { "type": ["string", "null"] },
        "target_path": {
          "type": "array",
          "items": { "type": "string" }
        },
        "external": { "type": "boolean" },
        "source_library_name": { "type": "string" }
      }
    },

    "resolution_step": {
      "type": "object",
      "required": ["token_id", "mode_id"],
      "properties": {
        "token_id": { "type": "string" },
        "mode_id": { "type": "string" }
      }
    },

    "alias_resolution": {
      "type": "object",
      "required": ["chain"],
      "properties": {
        "chain": {
          "type": "array",
          "items": { "$ref": "#/$defs/resolution_step" }
        }
      },
      "oneOf": [
        {
          "type": "object",
          "required": ["status", "value"],
          "properties": {
            "status": { "const": "resolved" },
            "value": { "$ref": "#/$defs/typed_value" }
          }
        },
        {
          "type": "object",
          "required": ["status", "reason", "value"],
          "properties": {
            "status": { "const": "unresolved" },
            "reason": { "type": "string", "minLength": 1 },
            "value": { "const": null }
          }
        }
      ]
    },

    "style_property_source": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind"],
          "properties": { "kind": { "const": "literal" } }
        },
        {
          "type": "object",
          "required": ["kind", "target_id", "target_path"],
          "properties": {
            "kind": { "const": "alias" },
            "target_id": { "type": ["string", "null"] },
            "target_path": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        }
      ]
    },
    "style_property": {
      "type": "object",
      "required": ["source", "resolved"],
      "properties": {
        "source": { "$ref": "#/$defs/style_property_source" },
        "resolved": {
          "oneOf": [
            { "$ref": "#/$defs/typed_value" },
            { "type": "null" }
          ]
        }
      }
    },
    "typography_properties": {
      "type": "object",
      "required": [
        "font_family", "font_weight", "font_size", "line_height",
        "letter_spacing", "paragraph_spacing", "paragraph_indent",
        "text_case", "text_decoration"
      ],
      "properties": {
        "font_family": { "$ref": "#/$defs/style_property" },
        "font_weight": { "$ref": "#/$defs/style_property" },
        "font_size": { "$ref": "#/$defs/style_property" },
        "line_height": { "$ref": "#/$defs/style_property" },
        "letter_spacing": { "$ref": "#/$defs/style_property" },
        "paragraph_spacing": { "$ref": "#/$defs/style_property" },
        "paragraph_indent": { "$ref": "#/$defs/style_property" },
        "text_case": { "type": "string" },
        "text_decoration": { "type": "string" }
      }
    },
    "typography_style": {
      "allOf": [
        { "$ref": "#/$defs/entity_identity" },
        {
          "type": "object",
          "required": ["description", "properties"],
          "properties": {
            "description": { "type": "string" },
            "properties": { "$ref": "#/$defs/typography_properties" },
            "publication": { "$ref": "#/$defs/publication" },
            "source": { "$ref": "#/$defs/source_state" },
            "lifecycle": { "$ref": "#/$defs/lifecycle" }
          }
        }
      ]
    },
    "effect_kind": {
      "type": "string",
      "enum": ["drop_shadow", "inner_shadow", "layer_blur", "background_blur"]
    },
    "effect": {
      "type": "object",
      "required": ["type", "visible"],
      "properties": {
        "type": { "$ref": "#/$defs/effect_kind" },
        "visible": { "type": "boolean" },
        "blend_mode": { "type": "string" },
        "color": { "$ref": "#/$defs/color_value" },
        "offset_x": { "$ref": "#/$defs/dimension_value" },
        "offset_y": { "$ref": "#/$defs/dimension_value" },
        "blur": { "$ref": "#/$defs/dimension_value" },
        "spread": { "$ref": "#/$defs/dimension_value" },
        "show_behind_node": { "type": "boolean" }
      }
    },
    "style_binding": {
      "type": "object",
      "required": ["property", "token_id"],
      "properties": {
        "property": { "type": "string", "minLength": 1 },
        "token_id": { "type": "string", "minLength": 1 }
      }
    },
    "effect_style": {
      "allOf": [
        { "$ref": "#/$defs/entity_identity" },
        {
          "type": "object",
          "required": ["mode_id", "effects"],
          "properties": {
            "mode_id": { "type": ["string", "null"] },
            "effects": {
              "type": "array",
              "items": { "$ref": "#/$defs/effect" }
            },
            "bindings": {
              "type": "array",
              "items": { "$ref": "#/$defs/style_binding" }
            },
            "publication": { "$ref": "#/$defs/publication" },
            "source": { "$ref": "#/$defs/source_state" },
            "lifecycle": { "$ref": "#/$defs/lifecycle" }
          }
        }
      ]
    },

    "typed_value": {
      "oneOf": [
        { "$ref": "#/$defs/color_value" },
        { "$ref": "#/$defs/dimension_value" },
        { "$ref": "#/$defs/number_value" },
        { "$ref": "#/$defs/string_value" },
        { "$ref": "#/$defs/boolean_value" },
        { "$ref": "#/$defs/duration_value" },
        { "$ref": "#/$defs/cubic_bezier_value" },
        { "$ref": "#/$defs/font_family_value" }
      ]
    },
    "color_value": {
      "type": "object",
      "required": ["type", "color_space", "hex", "alpha"],
      "properties": {
        "type": { "const": "color" },
        "color_space": { "const": "srgb" },
        "hex": { "type": "string", "pattern": "^#[0-9a-f]{6}$" },
        "alpha": { "type": "number", "minimum": 0, "maximum": 1 },
        "channels": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": { "type": "number" }
        }
      }
    },
    "dimension_value": {
      "type": "object",
      "required": ["type", "number", "unit"],
      "properties": {
        "type": { "const": "dimension" },
        "number": { "type": "number" },
        "unit": { "$ref": "#/$defs/unit" }
      }
    },
    "number_value": {
      "type": "object",
      "required": ["type", "value"],
      "properties": {
        "type": { "const": "number" },
        "value": { "type": "number" }
      }
    },
    "string_value": {
      "type": "object",
      "required": ["type", "value"],
      "properties": {
        "type": { "const": "string" },
        "value": { "type": "string" }
      }
    },
    "boolean_value": {
      "type": "object",
      "required": ["type", "value"],
      "properties": {
        "type": { "const": "boolean" },
        "value": { "type": "boolean" }
      }
    },
    "duration_value": {
      "type": "object",
      "required": ["type", "number", "unit"],
      "properties": {
        "type": { "const": "duration" },
        "number": { "type": "number" },
        "unit": { "enum": ["ms", "s"] }
      }
    },
    "cubic_bezier_value": {
      "type": "object",
      "required": ["type", "value"],
      "properties": {
        "type": { "const": "cubic_bezier" },
        "value": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": { "type": "number" }
        }
      }
    },
    "font_family_value": {
      "type": "object",
      "required": ["type", "value"],
      "properties": {
        "type": { "const": "font_family" },
        "value": { "type": "string" }
      }
    }
  }
}
