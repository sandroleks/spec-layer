{
  "Motion": {
    "motion": {
      "duration": {
        "button": {
          "$type": "duration",
          "$value": "{Motion.motion.duration.fast}"
        },
        "fast": {
          "$type": "duration",
          "$value": {
            "unit": "s",
            "value": 0.3
          },
          "$description": "Short transitions."
        }
      },
      "ease": {
        "standard": {
          "$type": "cubicBezier",
          "$value": [
            0.2,
            0,
            0,
            1
          ]
        }
      }
    }
  }
}
