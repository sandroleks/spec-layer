{
  "Effect styles": {
    "Elevation": {
      "1": {
        "$type": "shadow",
        "$value": [
          {
            "blur": {
              "unit": "px",
              "value": 3
            },
            "color": {
              "alpha": 0.16,
              "colorSpace": "srgb",
              "components": [
                0,
                0,
                0
              ],
              "hex": "#000000"
            },
            "inset": false,
            "offsetX": {
              "unit": "px",
              "value": 0
            },
            "offsetY": {
              "unit": "px",
              "value": 1
            },
            "spread": {
              "unit": "px",
              "value": 0
            }
          }
        ],
        "$extensions": {
          "com.spec-layer": {
            "layers": [
              {
                "blend_mode": "normal",
                "index": 0,
                "type": "drop_shadow",
                "visible": true
              }
            ]
          }
        }
      }
    }
  }
}
