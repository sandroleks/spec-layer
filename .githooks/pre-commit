#!/usr/bin/env bash
# Reject commits that contain known secret patterns.
#
# The patterns live in scripts/check-secrets.mjs, which CI also runs over every
# pull request and the whole tree, so skipping this hook with --no-verify only
# moves the failure to CI.
set -euo pipefail

exec node "$(dirname "$0")/../scripts/check-secrets.mjs" --staged
